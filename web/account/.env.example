MD_ACCOUNT_URL=http://127.0.0.1:3000
MD_ACCOUNT_SECRET=dev-only-change-me

# Optional — without these, checkout activates Pro locally
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Only needed if MD_ACCOUNT_URL is unset and you want Secure cookies in production
# MD_COOKIE_SECURE=1
